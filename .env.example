# PostgreSQL (Docker / Linux deployment)
POSTGRES_USER=taskmesh
POSTGRES_PASSWORD=taskmesh_secret
POSTGRES_DB=taskmesh

# Server
DATABASE_URL=postgresql://taskmesh:taskmesh_secret@postgres:5432/taskmesh
AI_SERVICE_URL=http://ai-service:8000
PORT=4000

# Ports exposed to the host (Docker only)
# SERVER_PORT is the host port mapped to the Node server (default 4000)
# CLIENT_PORT is the host port mapped to the React app (default 3000 prod / 5173 dev)
# Update VITE_API_URL below to match SERVER_PORT if you change it.
SERVER_PORT=4000
CLIENT_PORT=3000

# AI Service
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=tiny

# Documentation - Set the path where documents will be saved on your local machine
# Windows example: DOCUMENTATION_PATH=C:\Users\YourName\Documents\TaskMesh
# Linux example:   DOCUMENTATION_PATH=/home/yourname/documents/taskmesh
DOCUMENTATION_PATH=C:\Users\micha\Documents\TaskMesh

# Client (build-time)
VITE_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# GitHub token for update checks (optional — only needed if repo is private)
# Create at: GitHub → Settings → Developer settings → Fine-grained tokens
# Required permission: Contents (read-only) on the TaskMesh repo
GITHUB_TOKEN=

# PostHog In-App Telemetry (server-side, optional)
# Events are only sent when the user opts in via Settings → Privacy
# Leave blank to disable telemetry entirely
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────────────────────────────────────────────────────────
# Windows Installer (one-click setup — no Docker required)
# ─────────────────────────────────────────────────────────────────
# DATABASE_URL=file:./taskmesh.db
# AI_SERVICE_URL=http://localhost:8000
# PORT=4000
# NODE_ENV=production
# VITE_API_URL=http://localhost:4000
# DOCUMENTATION_PATH=C:\Users\YourName\Documents\TaskMesh\documentation
