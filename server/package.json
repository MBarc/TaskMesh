{
  "name": "taskmesh-server",
  "version": "0.0.23",
  "description": "TaskMesh Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');const d='src/connectors';fs.readdirSync(d,{withFileTypes:true}).filter(e=>e.isDirectory()&&e.name!=='framework').forEach(e=>{const s=p.join(d,e.name,'manifest.json'),t=p.join('dist/connectors',e.name,'manifest.json');if(fs.existsSync(s))fs.copyFileSync(s,t)})\"",
    "start": "prisma db push --accept-data-loss && node dist/index.js",
    "start:windows": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "esbuild": "^0.27.3",
    "express": "^4.21.1",
    "imapflow": "^1.0.165",
    "js-yaml": "^4.1.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "posthog-node": "^5.28.1",
    "prisma": "^5.22.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
