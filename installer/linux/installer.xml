<?xml version="1.0" encoding="UTF-8"?>
<!--
    TaskMesh Linux Installer — Qt Installer Framework configuration
    https://doc.qt.io/qtinstallerframework/ifw-globalconfig.html
-->
<Installer>
    <Name>TaskMesh</Name>
    <Version>1.0.0</Version>
    <Title>TaskMesh Setup</Title>
    <Publisher>TaskMesh</Publisher>
    <ProductUrl>https://taskmesh.co</ProductUrl>

    <!-- Brand icon — 256×256 PNG generated by build.sh (replace with real asset) -->
    <InstallerWindowIcon>assets/taskmesh.png</InstallerWindowIcon>
    <Logo>assets/taskmesh.png</Logo>
    <Watermark>assets/taskmesh.png</Watermark>

    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>740</WizardDefaultWidth>
    <WizardDefaultHeight>580</WizardDefaultHeight>

    <!-- System-wide install: /opt/taskmesh.  Users can override on the target dir page. -->
    <TargetDir>/opt/taskmesh</TargetDir>
    <AdminTargetDir>/opt/taskmesh</AdminTargetDir>

    <!-- Maintenance tool left in the install dir so users can repair / uninstall -->
    <MaintenanceToolName>taskmesh-uninstall</MaintenanceToolName>

    <!-- Remove the target directory on uninstall (scripts clean up /var/lib/taskmesh separately) -->
    <RemoveTargetDir>true</RemoveTargetDir>

    <!-- License shown on the license acceptance page -->
    <LicenseFile>../shared/LICENSE.txt</LicenseFile>

    <AllowNonAsciiCharacters>false</AllowNonAsciiCharacters>
    <RepositorySettingsPageVisible>false</RepositorySettingsPageVisible>
    <CreateLocalRepository>false</CreateLocalRepository>
    <InstallActionColumnVisible>false</InstallActionColumnVisible>
</Installer>
